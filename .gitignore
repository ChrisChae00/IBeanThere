# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node/Next.js (frontend)
node_modules/
.next/
out/
.vercel/
.npm/
.pnp*/
.turbo/
.cache/

# Env files — ignore every shape (.env, .env.local, foo.env, foo.env.bar), then
# name the one exception. `!.env.example` must be the LAST env rule: a later
# ignore pattern that also matches .env.example (e.g. *.env.*) re-ignores it,
# since git resolves overlapping patterns in file order, last match wins.
.env
.env.*
*.env
*.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

